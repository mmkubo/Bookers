<div class="index">
<h1>Books</h1>

  <table>
    <thead>
      <tr>
        <th>Title</th>
        <th>Body</th>
      </tr>
    </thead>
    <tbody>
      <% @books.each do |book| %>
      <tr>
        <td><%= book.title %></td>
        <td><%= book.body %></td>
        <td><span class="index-link">
          <%=link_to "Show", book_path(book.id) %>
          </span></td>
        <td><span class="index-link">
          <%=link_to "Edit", edit_book_path(book.id) %>
          </span></td>
        <td><span class="index-link">
          <%=link_to "Destroy", book_path(book.id), data: { turbo_method: :delete, turbo_confirm: "Are you sure?"} %>
          </span></td>
      </tr>
      <% end %>
    </tbody>
  </table>
</div>

<div class="form">
<h2>New book</h2>


<% if @book.errors.any? %>
  <div class="error_explanation">
  <h2 class="error-title"><%= @book.errors.count %> errors prohibited this book from being saved:<h2>
  <ul>
    <% @book.errors.full_messages.each do |message| %>
      <li><%= message %></li>
    <% end %>
  </ul>
<% end %>
</div>


<%= form_with model: @book do |f| %>

  <div class="field">
    <%= f.label :title, "Title" %>
    <%= f.text_field :title %>
  </div>
  <div class="field">
    <%= f.label :body, "Body" %>
    <%= f.text_area :body %>
  </div>

  <div class="submit">
  <%= f.submit "Create Book" %>
  </div>

<% end %>
</div>
