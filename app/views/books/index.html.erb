<h2>Books</h2>

  <table>
    <thead>
      <tr>
        <th>title</th>
        <th>body</th>
        <th></th>
       <th></th>
       <th></th>
      </tr>
    </thead>
    <tbody>
      <% @books.each do |book| %>
      <tr>
        <td><%= book.title %></td>
        <td><%= book.body %></td>
        <td><%= "Show" %></td>
        <td><%= "Edit" %></td>
        <td><%= "Destroy" %></td>
      </tr>
    <% end %>
    </tbody>
  </table>



<h3>New book</h3>
<%= form_with model: @book do |f| %>

  <p>Title</p>
  <%= f.text_field :title %>
  <p>Body</p>
  <%= f.text_area :body %>

  <%= f.submit "Create Book" %>

<% end %>
